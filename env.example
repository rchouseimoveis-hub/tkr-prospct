# Cadastre estas variáveis em Vercel > Projeto > Settings > Environment Variables (nunca no código, nunca no GitHub).
SESSION_SECRET=            # OBRIGATÓRIA: texto aleatório de 32+ caracteres (assina sessões e links). Gere: openssl rand -base64 32
MASTER_EMAIL=              # OBRIGATÓRIA no 1º acesso: e-mail do Administrador Master
MASTER_PASSWORD=           # OBRIGATÓRIA no 1º acesso (10+ caracteres). Depois de entrar, apague esta variável.
UPSTASH_REDIS_REST_URL=    # Banco: Vercel > Storage > Upstash Redis (cria estas duas sozinho;
UPSTASH_REDIS_REST_TOKEN=  #   KV_REST_API_URL / KV_REST_API_TOKEN também funcionam)
GOOGLE_MAPS_KEY=           # chave do Google restrita à "Places API (New)" (busca de empresas)
CASADOSDADOS_KEY=          # api-key da Casa dos Dados (consulta de CNPJ; API paga)
BRAVE_SEARCH_KEY=          # opcional: Brave Search API (redes sociais das empresas; cobrança por consulta)
GERENTE_VE_TUDO=           # opcional: 1 = gerente vê todos os leads (padrão: só a equipe dele + sem dono)
ALLOWED_ORIGIN=            # opcional: só se o painel ficar em outro domínio
TKR_KEY=                   # opcional (legado): chave para usar os proxies sem sessão
