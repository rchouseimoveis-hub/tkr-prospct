# Cadastre em Vercel > Settings > Environment Variables (nunca no código).
SESSION_SECRET=        # texto aleatório com 32+ caracteres (assina sessões e links). Gere: openssl rand -base64 32
MASTER_EMAIL=          # e-mail do Administrador Master
MASTER_PASSWORD=       # senha inicial do Master (10+ caracteres); vale só no 1º login, depois troque no painel (🔑)
UPSTASH_REDIS_REST_URL=    # banco compartilhado: Vercel > Storage > Upstash Redis (cria estas duas;
UPSTASH_REDIS_REST_TOKEN=  #   KV_REST_API_URL / KV_REST_API_TOKEN também funcionam)
GOOGLE_MAPS_KEY=       # chave do Google, restrita à "Places API (New)"
CASADOSDADOS_KEY=      # api-key da Casa dos Dados (consulta de CNPJ; API paga)
BRAVE_SEARCH_KEY=      # opcional: Brave Search API (rastreio de redes sociais das empresas; cobrança por consulta)
GERENTE_VE_TUDO=       # opcional: 1 = gerente vê todos os leads (padrão: só sua equipe + sem dono)
ALLOWED_ORIGIN=        # opcional: só se painel e API ficarem em domínios diferentes
TKR_KEY=               # opcional (legado): chave para usar os proxies sem sessão
